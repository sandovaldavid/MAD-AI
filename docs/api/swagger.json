swagger: '2.0'
info:
  title: Backend-MAD-AI API
  description: Documentación de la API de autenticación y gestión de usuarios
  version: v1
host: localhost: 8004
schemes:
- http
basePath: /api/v1
consumes:
- application/json
produces:
- application/json
securityDefinitions:
  Basic:
    type: basic
security:
- Basic: []
paths:
  /auth/confirm-email/:
    post:
      operationId: auth_confirm-email_create
      description: Confirm user email address
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ConfirmEmail'
      responses:
        '200':
          description: Email confirmed successfully
        '400':
          description: Invalid token
      tags:
      - auth
    parameters: []
  /auth/login/:
    post:
      operationId: auth_login_create
      description: Authenticate user and return access tokens
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Login'
      responses:
        '200':
          description: Login successful
          schema:
            $ref: '#/definitions/AuthResponse'
        '401':
          description: Invalid credentials
      tags:
      - auth
    parameters: []
  /auth/logout/:
    post:
      operationId: auth_logout_create
      description: Logout user and revoke tokens
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Logout'
      responses:
        '200':
          description: Logged out successfully
      tags:
      - auth
    parameters: []
  /auth/me/:
    get:
      operationId: auth_me_list
      description: Get current user profile
      parameters: []
      responses:
        '200':
          description: User profile information
      tags:
      - auth
    parameters: []
  /auth/refresh-token/:
    post:
      operationId: auth_refresh-token_create
      description: Refresh access token
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/RefreshToken'
      responses:
        '200':
          description: Token refreshed successfully
          schema:
            $ref: '#/definitions/AuthResponse'
        '401':
          description: Invalid refresh token
      tags:
      - auth
    parameters: []
  /auth/register/:
    post:
      operationId: auth_register_create
      description: Register a new user account
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Register'
      responses:
        '201':
          description: User registered successfully
          schema:
            $ref: '#/definitions/AuthResponse'
        '400':
          description: Bad request
      tags:
      - auth
    parameters: []
  /auth/reset-password/:
    post:
      operationId: auth_reset-password_create
      description: Request password reset
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResetPasswordRequest'
      responses:
        '200':
          description: Password reset email sent
        '400':
          description: Invalid email
      tags:
      - auth
    parameters: []
  /auth/reset-password/confirm/:
    post:
      operationId: auth_reset-password_confirm_create
      description: Confirm password reset
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResetPasswordConfirm'
      responses:
        '200':
          description: Password reset successfully
        '400':
          description: Invalid token or password
      tags:
      - auth
    parameters: []
  /auth/roles/:
    get:
      operationId: auth_roles_list
      description: List all roles
      parameters: []
      responses:
        '200':
          description: List of roles
          schema:
            type: array
            items:
              $ref: '#/definitions/RoleList'
      tags:
      - auth
    parameters: []
  /auth/roles/assign/:
    post:
      operationId: auth_roles_assign_create
      description: Assign role to user
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/AssignRole'
      responses:
        '200':
          description: Role assigned successfully
        '400':
          description: Bad request
        '404':
          description: User or role not found
      tags:
      - auth
    parameters: []
  /auth/roles/create/:
    post:
      operationId: auth_roles_create_create
      description: Create a new role (admin only)
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CreateRole'
      responses:
        '201':
          description: Role created successfully
          schema:
            $ref: '#/definitions/RoleResponse'
        '400':
          description: Bad request
        '403':
          description: Forbidden
      tags:
      - auth
    parameters: []
  /auth/roles/unassign/:
    post:
      operationId: auth_roles_unassign_create
      description: Unassign role from user
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/UnassignRole'
      responses:
        '200':
          description: Role unassigned successfully
        '400':
          description: Bad request
        '404':
          description: User not found
      tags:
      - auth
    parameters: []
  /auth/roles/{role_id
}/:
    get:
      operationId: auth_roles_read
      description: Get role details by ID
      parameters: []
      responses:
        '200':
          description: Role details
          schema:
            $ref: '#/definitions/RoleResponse'
        '404':
          description: Role not found
      tags:
      - auth
    parameters:
    - name: role_id
      in: path
      required: true
      type: string
  /auth/roles/{role_id
}/delete/:
    delete:
      operationId: auth_roles_delete_delete
      description: Delete role
      parameters: []
      responses:
        '200':
          description: Role deleted successfully
        '400':
          description: Cannot delete role with assigned users
        '404':
          description: Role not found
      tags:
      - auth
    parameters:
    - name: role_id
      in: path
      required: true
      type: string
  /auth/roles/{role_id
}/update/:
    put:
      operationId: auth_roles_update_update
      description: Update role information
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/UpdateRole'
      responses:
        '200':
          description: Role updated successfully
          schema:
            $ref: '#/definitions/RoleResponse'
        '400':
          description: Bad request
        '404':
          description: Role not found
      tags:
      - auth
    parameters:
    - name: role_id
      in: path
      required: true
      type: string
  /auth/users/:
    get:
      operationId: auth_users_list
      description: List all users
      parameters: []
      responses:
        '200':
          description: List of users
          schema:
            type: array
            items:
              $ref: '#/definitions/UserList'
      tags:
      - auth
    parameters: []
  /auth/users/change-password/:
    post:
      operationId: auth_users_change-password_create
      description: Change user password
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ChangePassword'
      responses:
        '200':
          description: Password changed successfully
        '400':
          description: Bad request
      tags:
      - auth
    parameters: []
  /auth/users/create/:
    post:
      operationId: auth_users_create_create
      description: Create a new user (admin only)
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CreateUser'
      responses:
        '201':
          description: User created successfully
          schema:
            $ref: '#/definitions/UserResponse'
        '400':
          description: Bad request
        '403':
          description: Forbidden
      tags:
      - auth
    parameters: []
  /auth/users/{user_id
}/:
    get:
      operationId: auth_users_read
      description: Get user details by ID
      parameters: []
      responses:
        '200':
          description: User details
          schema:
            $ref: '#/definitions/UserResponse'
        '404':
          description: User not found
      tags:
      - auth
    parameters:
    - name: user_id
      in: path
      required: true
      type: string
  /auth/users/{user_id
}/activate/:
    put:
      operationId: auth_users_activate_update
      description: Activate user account
      parameters: []
      responses:
        '200':
          description: User activated successfully
        '404':
          description: User not found
      tags:
      - auth
    parameters:
    - name: user_id
      in: path
      required: true
      type: string
  /auth/users/{user_id
}/deactivate/:
    delete:
      operationId: auth_users_deactivate_delete
      description: Deactivate user account
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/DeactivateUser'
      responses:
        '200':
          description: User deactivated successfully
        '404':
          description: User not found
      tags:
      - auth
    parameters:
    - name: user_id
      in: path
      required: true
      type: string
  /auth/users/{user_id
}/update/:
    put:
      operationId: auth_users_update_update
      description: Update user information
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/UpdateUser'
      responses:
        '200':
          description: User updated successfully
          schema:
            $ref: '#/definitions/UserResponse'
        '400':
          description: Bad request
        '404':
          description: User not found
      tags:
      - auth
    parameters:
    - name: user_id
      in: path
      required: true
      type: string
  /resource_management/absences/:
    get:
      operationId: resource_management_absences_list
      summary: Listar ausencias de recursos
      description: Obtiene la lista paginada de todas las ausencias
      parameters:
      - name: search
        in: query
        description: A search term.
        required: false
        type: string
      - name: ordering
        in: query
        description: Which field to use when ordering the results.
        required: false
        type: string
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: page_size
        in: query
        description: Number of results to return per page.
        required: false
        type: integer
      responses:
        '200':
          description: Lista de ausencias
          schema:
            type: array
            items:
              $ref: '#/definitions/ResourceAbsenceList'
      tags:
      - RM - Absence Resources
    post:
      operationId: resource_management_absences_create
      summary: Crear ausencia de recurso
      description: Crea una nueva ausencia para un recurso
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResourceAbsenceCreateUpdate'
      responses:
        '201':
          description: Ausencia creada exitosamente
          schema:
            $ref: '#/definitions/ResourceAbsenceDetail'
        '400':
          description: Error de validación
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/bulk-approve/:
    post:
      operationId: resource_management_absences_bulk_approve
      summary: Aprobar ausencias en lote
      description: Aprueba múltiples ausencias de manera masiva
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResourceAbsenceBulkAction'
      responses:
        '200':
          description: Ausencias aprobadas exitosamente
          schema:
            $ref: '#/definitions/AbsenceBulkResult'
        '400':
          description: Error de validación
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/bulk-create/:
    post:
      operationId: resource_management_absences_bulk_create
      summary: Crear ausencias en lote
      description: Crea múltiples ausencias de manera masiva
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResourceAbsenceBulkAction'
      responses:
        '201':
          description: Ausencias creadas exitosamente
          schema:
            $ref: '#/definitions/AbsenceBulkResult'
        '400':
          description: Error de validación
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/calendar-view/:
    get:
      operationId: resource_management_absences_calendar_view
      summary: Vista de calendario de ausencias
      description: Obtiene datos para mostrar ausencias en formato de calendario
      parameters:
      - name: search
        in: query
        description: A search term.
        required: false
        type: string
      - name: ordering
        in: query
        description: Which field to use when ordering the results.
        required: false
        type: string
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: page_size
        in: query
        description: Number of results to return per page.
        required: false
        type: integer
      - name: start_date
        in: query
        description: Fecha de inicio (YYYY-MM-DD)
        type: string
        format: date
      - name: end_date
        in: query
        description: Fecha de fin (YYYY-MM-DD)
        type: string
        format: date
      responses:
        '200':
          description: Datos del calendario
          schema:
            $ref: '#/definitions/AbsenceCalendar'
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/conflict-report/:
    get:
      operationId: resource_management_absences_conflict_report
      summary: Generar reporte de conflictos en un período.
      description: GET /api/v1/absences/conflict-report/?start_date=2024-01-01&end_date=2024-12-31
      parameters:
      - name: search
        in: query
        description: Término de búsqueda
        type: string
      - name: ordering
        in: query
        description: Campo de ordenamiento
        type: string
      - name: page
        in: query
        description: Número de página
        type: integer
      - name: page_size
        in: query
        description: Tamaño de página
        type: integer
      - name: start_date
        in: query
        description: Fecha de inicio (YYYY-MM-DD)
        type: string
        format: date
      - name: end_date
        in: query
        description: Fecha de fin (YYYY-MM-DD)
        type: string
        format: date
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/ResourceAbsenceDetail'
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/my-absences/:
    get:
      operationId: resource_management_absences_my_absences
      summary: Mis ausencias
      description: Obtiene todas las ausencias del usuario autenticado
      parameters:
      - name: search
        in: query
        description: A search term.
        required: false
        type: string
      - name: ordering
        in: query
        description: Which field to use when ordering the results.
        required: false
        type: string
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: page_size
        in: query
        description: Number of results to return per page.
        required: false
        type: integer
      responses:
        '200':
          description: Lista de mis ausencias
          schema:
            type: array
            items:
              $ref: '#/definitions/AbsenceMyAbsences'
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/pending-approval/:
    get:
      operationId: resource_management_absences_pending_approval
      summary: Obtener ausencias pendientes de aprobación
      description: Lista todas las ausencias que están pendientes de aprobación
      parameters:
      - name: search
        in: query
        description: A search term.
        required: false
        type: string
      - name: ordering
        in: query
        description: Which field to use when ordering the results.
        required: false
        type: string
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: page_size
        in: query
        description: Number of results to return per page.
        required: false
        type: integer
      responses:
        '200':
          description: Lista de ausencias pendientes
          schema:
            type: array
            items:
              $ref: '#/definitions/ResourceAbsenceList'
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/period-report/:
    get:
      operationId: resource_management_absences_period_report
      summary: Generar reporte de ausencias por período.
      description: GET /api/v1/absences/period-report/?start_date=2024-01-01&end_date=2024-12-31
      parameters:
      - name: search
        in: query
        description: Término de búsqueda
        type: string
      - name: ordering
        in: query
        description: Campo de ordenamiento
        type: string
      - name: page
        in: query
        description: Número de página
        type: integer
      - name: page_size
        in: query
        description: Tamaño de página
        type: integer
      - name: start_date
        in: query
        description: Fecha de inicio (YYYY-MM-DD)
        required: true
        type: string
        format: date
      - name: end_date
        in: query
        description: Fecha de fin (YYYY-MM-DD)
        required: true
        type: string
        format: date
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/AbsencePeriod'
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/statistics/:
    get:
      operationId: resource_management_absences_statistics
      summary: Estadísticas de ausencias
      description: Obtiene estadísticas generales sobre las ausencias
      parameters:
      - name: search
        in: query
        description: A search term.
        required: false
        type: string
      - name: ordering
        in: query
        description: Which field to use when ordering the results.
        required: false
        type: string
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: page_size
        in: query
        description: Number of results to return per page.
        required: false
        type: integer
      responses:
        '200':
          description: Estadísticas de ausencias
          schema:
            $ref: '#/definitions/AbsenceStats'
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/team-absences/:
    get:
      operationId: resource_management_absences_team_absences
      summary: Ausencias del equipo
      description: Obtiene las ausencias del equipo (para managers)
      parameters:
      - name: search
        in: query
        description: A search term.
        required: false
        type: string
      - name: ordering
        in: query
        description: Which field to use when ordering the results.
        required: false
        type: string
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: page_size
        in: query
        description: Number of results to return per page.
        required: false
        type: integer
      responses:
        '200':
          description: Lista de ausencias del equipo
          schema:
            type: array
            items:
              $ref: '#/definitions/AbsenceTeamAbsences'
      tags:
      - RM - Absence Resources
    parameters: []
  /resource_management/absences/{id
}/:
    get:
      operationId: resource_management_absences_read
      summary: Obtener ausencia específica
      description: Obtiene los detalles de una ausencia específica
      parameters: []
      responses:
        '200':
          description: Detalles de la ausencia
          schema:
            $ref: '#/definitions/ResourceAbsenceDetail'
        '404':
          description: Ausencia no encontrada
      tags:
      - RM - Absence Resources
    put:
      operationId: resource_management_absences_update
      summary: Actualizar ausencia
      description: Actualiza completamente una ausencia existente
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResourceAbsenceCreateUpdate'
      responses:
        '200':
          description: Ausencia actualizada exitosamente
          schema:
            $ref: '#/definitions/ResourceAbsenceDetail'
        '400':
          description: Error de validación
        '404':
          description: Ausencia no encontrada
      tags:
      - RM - Absence Resources
    patch:
      operationId: resource_management_absences_partial_update
      summary: Actualizar parcialmente ausencia
      description: Actualiza parcialmente una ausencia existente
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResourceAbsenceCreateUpdate'
      responses:
        '200':
          description: Ausencia actualizada exitosamente
          schema:
            $ref: '#/definitions/ResourceAbsenceDetail'
        '400':
          description: Error de validación
        '404':
          description: Ausencia no encontrada
      tags:
      - RM - Absence Resources
    delete:
      operationId: resource_management_absences_delete
      summary: Eliminar ausencia
      description: Elimina una ausencia del sistema
      parameters: []
      responses:
        '204':
          description: Ausencia eliminada exitosamente
        '404':
          description: Ausencia no encontrada
      tags:
      - RM - Absence Resources
    parameters:
    - name: id
      in: path
      description: A unique integer value identifying this Resource Absence.
      required: true
      type: integer
  /resource_management/absences/{id
}/approve/:
    post:
      operationId: resource_management_absences_approve
      summary: Aprobar ausencia
      description: Aprueba una ausencia específica
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResourceAbsenceApproval'
      responses:
        '200':
          description: Ausencia aprobada exitosamente
        '404':
          description: Ausencia no encontrada
        '400':
          description: Error de validación
      tags:
      - RM - Absence Resources
    parameters:
    - name: id
      in: path
      description: A unique integer value identifying this Resource Absence.
      required: true
      type: integer
  /resource_management/absences/{id
}/reject/:
    post:
      operationId: resource_management_absences_reject
      summary: Rechazar ausencia
      description: Rechaza una ausencia específica
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/ResourceAbsenceApproval'
      responses:
        '200':
          description: Ausencia rechazada exitosamente
        '404':
          description: Ausencia no encontrada
        '400':
          description: Error de validación
      tags:
      - RM - Absence Resources
    parameters:
    - name: id
      in: path
      description: A unique integer value identifying this Resource Absence.
      required: true
      type: integer
  /resource_management/availabilities/analytics/:
    get:
      operationId: resource_management_availabilities_analytics
      summary: Análisis avanzado de disponibilidad
      description: Genera análisis avanzado con métricas, tendencias y recomendaciones
        de optimización
      parameters:
      - name: search
        in: query
        description: A search term.
        required: false
        type: string
      - name: ordering
        in: query
        description: Which field to use when ordering the results.
        required: false
        type: string
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: page_size
        in: query
        description: Number of results to return per page.
        required: false
        type: integer
      - name: fecha_inicio
        in: query
        description: Fecha de inicio del análisis (YYYY-MM-DD)
        type: string
        format: date
      - name: fecha_fin
        in: query
        description: Fecha de fin del análisis (YYYY-MM-DD)
        type: string
        format: date
