        in: query
        description: 'Ordenar por: start_date, allocation_percentage, created_at,
          is_leader'
        type: string
      - name: page
        in: query
        description: Número de página a recuperar
        required: false
        type: integer
      - name: page_size
        in: query
        description: Número de elementos por página
        required: false
        type: integer
