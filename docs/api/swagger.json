      - name: is_leader
        in: query
        description: Filtrar por miembros que son líderes
        type: boolean
      - name: allocation_min
        in: query
        description: Porcentaje mínimo de asignación
        type: integer
      - name: allocation_max
        in: query
        description: Porcentaje máximo de asignación
        type: integer
      - name: is_current_member
        in: query
        description: Filtrar por miembros actualmente activos
        type: boolean
