{
  "name": "mad-ai-new",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:MAD-AI-NEW": "node dist/MAD-AI-NEW/server/server.mjs",
    "lint": "eslint . --ext .ts,.js,.html",
    "format": "prettier --write \"src/**/*.{ts,js,html,css,scss,json,md}\"",
    "lint:icons": "node scripts/lint-icons.cjs",
    "fix:icons": "node scripts/lint-icons.cjs --fix",
    "fix:icons:dry": "node scripts/lint-icons.cjs --fix --dry",
    "test:jest:docker": "docker build -f Dockerfile.jest . -t mad-ai-jest && docker run --rm mad-ai-jest",
    "test:cypress:docker": "docker build -f Dockerfile.cypress . -t mad-ai-cypress && docker run --rm mad-ai-cypress",
    "test:docker:all": "docker-compose -f docker-compose.yml up --abort-on-container-exit --exit-code-from jest && docker-compose -f docker-compose.yml up --abort-on-container-exit --exit-code-from cypress",
    "prebuild": "npm run lint:icons"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.6",
    "@angular/common": "^20.1.6",
    "@angular/compiler": "^20.1.6",
    "@angular/core": "^20.1.6",
    "@angular/forms": "^20.1.6",
    "@angular/platform-browser": "^20.1.6",
    "@angular/platform-server": "^20.1.6",
    "@angular/router": "^20.1.6",
    "@angular/ssr": "^20.0.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/papaparse": "^5.3.16",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "ngx-echarts": "^20.0.2",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.2",
    "@angular/cli": "^20.0.2",
    "@angular/compiler-cli": "^20.1.6",
    "@angular/platform-browser-dynamic": "^20.1.6",
    "@inquirer/editor": "^4.2.15",
    "@inquirer/prompts": "^7.8.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "20.2.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-compact": "^8.40.0",
    "eslint-plugin-angular": "^5.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^54.1.1",
    "eslint-plugin-prettier": "^5.5.4",
    "external-editor": "^3.1.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "puppeteer": "^24.16.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.40.0"
  },
  "overrides": {
    "tmp": "0.2.4"
  }
}
